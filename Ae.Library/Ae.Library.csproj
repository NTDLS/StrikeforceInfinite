<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Title>Axis Engine</Title>
		<Company>NetworkDLS</Company>
		<Copyright>Copyright © 2026 NetworkDLS</Copyright>
		<Version>0.0.37</Version>
		<Authors>NetworkDLS</Authors>

		<OutputType>Library</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<RepositoryType>git</RepositoryType>
		<ApplicationIcon>AeIcon.ico</ApplicationIcon>
	</PropertyGroup>

	<ItemGroup>
	  <Compile Remove="Compiler\Templates\AeRuntimeCompiledSpriteAsset.cs" />
	  <Compile Remove="Compiler\Templates\IAeRuntimeCompiledCodeAsset.cs" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="AeIcon.ico" />
	</ItemGroup>

	<ItemGroup>
	  <EmbeddedResource Include="Compiler\Templates\DynamicCompileImports.txt" />
	  <EmbeddedResource Include="Compiler\Templates\SimpleClassWithBase.txt" />
	  <EmbeddedResource Include="Compiler\Templates\SimpleClassWithoutBase.txt" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="NTDLS.Helpers" Version="1.3.19" />
		<PackageReference Include="NTDLS.Semaphore" Version="3.5.4" />
		<PackageReference Include="System.Runtime.Caching" Version="10.0.3" />
	</ItemGroup>
</Project>
