<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Title>Axis Engine</Title>
		<Company>NetworkDLS</Company>
		<Copyright>Copyright © 2026 NetworkDLS</Copyright>
		<Version>0.0.46</Version>
		<Authors>NetworkDLS</Authors>

		<Nullable>enable</Nullable>
		<OutputType>Library</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<UseWindowsForms>true</UseWindowsForms>
		<AssemblyName>Ae.Engine</AssemblyName>
		<RootNamespace>Ae.Engine</RootNamespace>
		<ApplicationIcon>AeIcon.ico</ApplicationIcon>

		<TargetFrameworks></TargetFrameworks>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<Description>
			Axis Engine is a 2D game engine written in C# and rendered with DirectX.
		</Description>
		<PackageProjectUrl>https://github.com/NTDLS/AxisEngine</PackageProjectUrl>
		<RepositoryUrl>https://github.com/NTDLS/AxisEngine</RepositoryUrl>
		<PackageTags>game-engnie</PackageTags>
		<PackageReleaseNotes>
			Initial release, super alpha.
		</PackageReleaseNotes>
		<RepositoryType>git</RepositoryType>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<Authors>NetworkDLS</Authors>
		<Company>NetworkDLS</Company>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<IncludeSymbols>True</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<PackageIcon>Logo.png</PackageIcon>
	</PropertyGroup>

	<ItemGroup>
		<Compile Remove="Assets\Loadouts\**" />
		<Compile Remove="Resources\**" />
		<Compile Remove="Utility\**" />
		<EmbeddedResource Remove="Assets\Loadouts\**" />
		<EmbeddedResource Remove="Resources\**" />
		<EmbeddedResource Remove="Utility\**" />
		<None Remove="Assets\Loadouts\**" />
		<None Remove="Resources\**" />
		<None Remove="Utility\**" />
	</ItemGroup>

	<ItemGroup>
		<Content Remove="C:\Users\ntdls\.nuget\packages\ntdls.delegatethreadpooling\1.2.11\contentFiles\any\net8.0\Image.ico" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="AeIcon.ico" />
	</ItemGroup>

	<ItemGroup>
	  <EmbeddedResource Include="Compiler\Templates\DynamicCompileImports.txt" />
	  <EmbeddedResource Include="Compiler\Templates\SimpleClassWithBase.txt" />
	  <EmbeddedResource Include="Compiler\Templates\SimpleClassWithoutBase.txt" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.Common" Version="5.3.0" />
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="NTDLS.DelegateThreadPooling" Version="2.0.4" />
		<PackageReference Include="NTDLS.Helpers" Version="1.3.19" />
		<PackageReference Include="NTDLS.Persistence" Version="1.3.1" />
		<PackageReference Include="NTDLS.Semaphore" Version="3.5.4" />
		<PackageReference Include="NTDLS.SqliteDapperWrapper" Version="1.4.2" />
		<PackageReference Include="SharpDX" Version="4.2.0" />
		<PackageReference Include="SharpDX.Direct2D1" Version="4.2.0" />
		<PackageReference Include="SharpDX.DirectInput" Version="4.2.0" />
		<PackageReference Include="SharpDX.Mathematics" Version="4.2.0" />
		<PackageReference Include="SharpDX.XAudio2" Version="4.2.0" />
		<PackageReference Include="SharpDX.XInput" Version="4.2.0" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\Ae.MpClientToServerComms\Ae.MpClientToServerComms.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Compile Update="Properties\Resources.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>Resources.resx</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Update="Properties\Resources.resx">
			<Generator>ResXFileCodeGenerator</Generator>
			<LastGenOutput>Resources.Designer.cs</LastGenOutput>
		</EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
		<None Include="..\Logo.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

</Project>