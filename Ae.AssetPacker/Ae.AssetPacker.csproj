	<ItemGroup>
	  <EmbeddedResource Include="Scripts\CreateAssetsTable.sql" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="NTDLS.Helpers" Version="1.3.19" />
		<PackageReference Include="NTDLS.SqliteDapperWrapper" Version="1.3.3" />
		<PackageReference Include="System.CommandLine" Version="2.0.5" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Ae.Engine\Ae.Engine.csproj" />
	</ItemGroup>

</Project>
